# ─── PostgreSQL via Supabase ──────────────────────────────────────────────────

# Pooler connection (para runtime / Vercel)
# Settings → Database → Connection pooling → Connection string (Transaction mode)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (solo para prisma migrate)
# Settings → Database → Connection string → URI (Direct)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ─── Anthropic AI (opcional) ──────────────────────────────────────────────────
# Sin esta key el AI evaluator usa heurística determinista
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-6"

# ─── Google Cloud Storage (opcional) ─────────────────────────────────────────
# Sin esto el Evidence hub funciona solo con URLs (Figma, repos, Storybook…)
GCS_BUCKET="dsmr-evidence"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Email del usuario demo (debe existir en Supabase Auth o crearse con signUp)
DEMO_EMAIL="admin@demo.com"
