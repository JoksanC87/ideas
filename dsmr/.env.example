# PostgreSQL (Supabase connection string)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?schema=public&sslmode=require"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[your-anon-key]"

# Anthropic AI (optional - heuristic fallback if not set)
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-6"

# Google Cloud Storage (optional - URL-only evidence works without it)
GCS_BUCKET="dsmr-evidence"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Demo user email for seed
DEMO_EMAIL="admin@demo.com"
